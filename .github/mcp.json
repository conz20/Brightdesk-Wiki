{
  "mcpServers": {
    "cloudflare-api": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ${COPILOT_MCP_CLOUDFLARE_API_TOKEN}"
      },
      "tools": ["search", "execute"]
    },
    "cloudflare-docs": {
      "type": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "tools": ["search_cloudflare_documentation"]
    }
  }
}
